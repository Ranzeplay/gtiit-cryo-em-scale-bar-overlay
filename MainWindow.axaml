<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScaleBarOverlay"
        x:DataType="local:MainWindow"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
        x:Class="ScaleBarOverlay.MainWindow"
        DragDrop.AllowDrop="True"
        Title="ScaleBarOverlay">

    <Grid Margin="10" ColumnDefinitions="*,10,500">

        <!-- DataGrid takes the entire left space -->
        <DataGrid Grid.Column="0"
                  ItemsSource="{Binding ImageTasks}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  CanUserResizeColumns="True"
                  VerticalScrollBarVisibility="Auto"
                  Name="ImagesDataGrid"
                  SelectionChanged="OnDataGridSelectionChanged"
                  DoubleTapped="InputElement_OnDoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Image Path"
                                    Binding="{Binding ImageName}"
                                    Width="*" />
                <DataGridTextColumn Header="Magnification"
                                    Binding="{Binding Magnification.DisplayText}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Scale text alignment"
                                    Binding="{Binding AlignmentOption}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Output Path"
                                    Binding="{Binding OutputPath}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Right layout -->
        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="20,0,0,0" Spacing="20">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Spacing="10"
                        Margin="0,0,0,5">
                <Button Content="Clear" Click="OnClearClicked" />
                <Button Content="Reset output folder" Click="OnResetOutputDirectoryClicked" />
                <Button Content="Add" Click="OnAddClicked" />
                <Button Content="Process" Click="OnProcessClicked" />
            </StackPanel>
            
            <Border x:Name="PreviewBorder"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="0,0,0,0"
                    Height="{Binding Bounds.Width, ElementName=PreviewBorder}">
                <Grid>
                    <Image Stretch="Uniform" Source="{Binding PreviewImageSource}" />
                    <!-- Loading indicator -->
                    <Border IsVisible="{Binding IsPreviewLoading}"
                            Background="#80000000"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <ProgressBar IsIndeterminate="True"
                                     Width="100"
                                     Height="10"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                    </Border>
                    <!-- No image hint -->
                    <TextBlock IsVisible="{Binding PreviewImageSource, Converter={x:Static ObjectConverters.IsNull}}"
                               Text="Select an image to view preview"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.5" />
                </Grid>
            </Border>
            
            <StackPanel Margin="0,0,0,0" Spacing="10">
                <TextBlock Grid.Row="0"
                           Text="Scale Bar Margins:"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />

                <Grid ColumnDefinitions="200,200">
                    <TextBlock Text="Scale bar edge:" Margin="0,0,0,4" Grid.Column="0" />
                    <ComboBox Grid.Column="1"
                              x:Name="ScaleBarEdgeLocation"
                              ItemsSource="{Binding EdgeOptions}"
                              SelectedItem="{Binding SelectedEdge}"
                              SelectedIndex="2"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="ScaleBarEdgeLocation_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Numeric input area - placed independently below slider -->
                <Grid ColumnDefinitions="200,200">
                    <TextBlock Grid.Column="0"
                               Text="Horizontal offset:"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,10,0" />

                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding ScaleBarHorizontalOffset}"
                                   Minimum="10"
                                   Maximum="4000"
                                   Increment="100"
                                   Width="150"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Padding="5"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   ButtonSpinnerLocation="Right"
                                   ShowButtonSpinner="True"
                                   AllowSpin="True"
                                   ClipValueToMinMax="True"
                                   FormatString="0"
                                   IsEnabled="{Binding !!SelectedImageTask}">
                        <NumericUpDown.Styles>
                            <Style Selector="NumericUpDown /template/ TextBox">
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </NumericUpDown.Styles>
                    </NumericUpDown>
                </Grid>

                <Grid ColumnDefinitions="200,200">

                    <TextBlock Grid.Column="0"
                               Text="Vertical offset:"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,10,0" />

                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding ScaleBarVerticalOffset}"
                                   Minimum="10"
                                   Maximum="4000"
                                   Increment="100"
                                   Width="150"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Padding="5"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   ButtonSpinnerLocation="Right"
                                   ShowButtonSpinner="True"
                                   AllowSpin="True"
                                   ClipValueToMinMax="True"
                                   FormatString="0"
                                   IsEnabled="{Binding !!SelectedImageTask}">
                        <NumericUpDown.Styles>
                            <Style Selector="NumericUpDown /template/ TextBox">
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </NumericUpDown.Styles>
                    </NumericUpDown>
                </Grid>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Left">
                <CheckBox Content="Show Processed Preview" IsChecked="{Binding !IsOriginalPreview}" Margin="0,0,10,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>